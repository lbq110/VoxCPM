# --- Brain: OpenRouter (https://openrouter.ai/keys) ---
OPENROUTER_API_KEY=sk-or-...
# Any OpenRouter model id. The UI defaults to xAI/Grok.
CHAT_MODEL=x-ai/grok-4.3

# --- Voice: the VoxCPM voice server ---
# RunPod:  https://<pod-id>-8000.proxy.runpod.net
# Local:   http://localhost:8000
# RunPod SSH tunnel from voice-server/tunnel.sh: http://localhost:8001
VOICE_SERVER_URL=http://localhost:8001
# Must match VOICE_API_KEY set on the voice server (leave blank if none).
VOICE_API_KEY=

# --- ASR on voice-server ---
# SenseVoice-Small runs locally through FunASR.
# Voxtral Realtime runs through Mistral and requires this on voice-server.
# MISTRAL_API_KEY=...

# Optional: override the assistant's personality.
# SYSTEM_PROMPT=You are a warm, concise voice assistant...
